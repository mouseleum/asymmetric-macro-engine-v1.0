MACRO_VAULT_URL=https://macro-vault-v3.vercel.app
MACRO_VAULT_API_KEY=

# Optional: force local fixtures instead of live Vault requests.
NEXT_PUBLIC_USE_MOCK_VAULT=false

# Optional latest-series selector for /api/vault/latest.
